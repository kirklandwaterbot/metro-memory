{
  "name": "metro-memory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:core",
    "dev:bg": "node scripts/dev-server.js start",
    "dev:status": "node scripts/dev-server.js status",
    "dev:stop": "node scripts/dev-server.js stop",
    "dev:logs": "node scripts/dev-server.js logs",
    "dev:core": "node scripts/repair-next-dev-cache.js && node scripts/sync-city-assets.js && node scripts/sync-city-card-images.js && node scripts/dev-with-asset-watch.js --turbo -H 0.0.0.0",
    "dev:turbo": "node scripts/repair-next-dev-cache.js && node scripts/sync-city-assets.js && node scripts/sync-city-card-images.js && node scripts/dev-with-asset-watch.js --turbo",
    "build": "node scripts/build.js",
    "build:mobile": "node scripts/build-mobile.js",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "prebuild": "node scripts/check-mojibake.js --write",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "check:mojibake": "node scripts/check-mojibake.js",
    "fix:mojibake": "node scripts/check-mojibake.js --write",
    "predev:core": "node scripts/check-mojibake.js --write",
    "predev:turbo": "node scripts/check-mojibake.js --write",
    "i18n:extract": "node scripts/i18n-extract.js",
    "i18n:translate": "node scripts/i18n-translate.js",
    "i18n:check": "node scripts/i18n-check.js",
    "db:generate": "prisma generate --no-hints",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "check:auth-env": "node --experimental-strip-types scripts/check-auth-env.ts",
    "test:automation": "node --experimental-strip-types --test tests/automation/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "check:duplicate-keys": "node scripts/check-duplicate-object-keys.js",
    "generate:station-totals": "node scripts/generate-station-totals.js",
    "audit:station-aliases": "node scripts/audit-station-aliases.js",
    "research:run": "node scripts/run-ts.js scripts/research/run.ts",
    "research:loop": "node scripts/run-ts.js scripts/research/research-loop.ts",
    "env:sync": "node scripts/sync-env.js",
    "sync:city-assets": "node scripts/sync-city-assets.js",
    "sync:icons": "node scripts/sync-city-assets.js && node scripts/sync-city-image-folders.js && node scripts/sync-city-icons.js",
    "sync:images": "node scripts/sync-city-image-folders.js",
    "r2:sync": "node --env-file-if-exists=.env.local scripts/sync-r2-assets.mjs",
    "r2:sync:dry-run": "node --env-file-if-exists=.env.local scripts/sync-r2-assets.mjs --dry-run",
    "generate:city-data": "node scripts/export-city-data.js",
    "generate:available-city-data": "node scripts/generate-available-city-data.js",
    "sync:icons:watch": "node scripts/auto-sync-city-icons.js",
    "sync:images:watch": "node scripts/auto-sync-city-image-folders.js"
  },
